<?xml version="1.0" encoding="utf-8"?>
<!-- Material Glass, wide: Material You surface, rounded cover, Play as a primary pill between tonal buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_material"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/widget_cover_material"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_nothing_playing"
            android:textColor="@color/widget_material_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_material_on_surface_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_tonal_material"
                android:contentDescription="@string/widget_previous"
                android:padding="11dp"
                android:src="@drawable/widget_previous"
                android:tint="@color/widget_material_on_tonal" />

            <ImageView
                android:id="@+id/play"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/widget_pill_material"
                android:contentDescription="@string/widget_play"
                android:paddingVertical="11dp"
                android:src="@drawable/widget_play"
                android:tint="@color/widget_material_on_primary" />

            <ImageView
                android:id="@+id/next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_tonal_material"
                android:contentDescription="@string/widget_next"
                android:padding="11dp"
                android:src="@drawable/widget_next"
                android:tint="@color/widget_material_on_tonal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass, wide: cover, title and artist, transport, on a card in the cover's colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_liquid"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/widget_cover_liquid"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nothing_playing"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_previous"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:foreground="@drawable/widget_feedback_circle"
                android:foregroundGravity="fill"
                android:padding="13dp"
                android:src="@drawable/widget_previous" />

            <ImageView
                android:id="@+id/play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/widget_circle"
                android:contentDescription="@string/widget_play"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:foreground="@drawable/widget_feedback_circle"
                android:foregroundGravity="fill"
                android:padding="13dp"
                android:src="@drawable/widget_play" />

            <ImageView
                android:id="@+id/next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_next"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:foreground="@drawable/widget_feedback_circle"
                android:foregroundGravity="fill"
                android:padding="13dp"
                android:src="@drawable/widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch splash (Android 12+ splash screen API), drawn after the app icon: the glass bubble
  swells in, then its sound bars grow from the middle outwards like an equalizer.
  The bubble spans the 160 dp circle the system shows.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="bubble"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <path android:pathData="M54,18a36,36 0 1,1 0,72a36,36 0 1,1 0,-72z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="18" android:startY="18"
                            android:endX="90" android:endY="90"
                            android:startColor="#FFAE96FB"
                            android:endColor="#FF5030E6" />
                    </aapt:attr>
                </path>
                <path
                    android:strokeColor="#B3FFFFFF"
                    android:strokeWidth="1.4"
                    android:pathData="M54,19.5a34.5,34.5 0 1,1 0,69a34.5,34.5 0 1,1 0,-69z" />
                <path
                    android:strokeColor="#66FFFFFF"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M30,40A28,28 0 0,1 58,26.3" />
            </group>
            <group
                android:name="bar0"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleY="0">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M38.12,52.62a2.12,2.12 0 0,1 4.25,0v2.75a2.12,2.12 0 0,1 -4.25,0z" />
            </group>
            <group
                android:name="bar1"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleY="0">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M43.88,48.62a2.62,2.62 0 0,1 5.25,0v10.75a2.62,2.62 0 0,1 -5.25,0z" />
            </group>
            <group
                android:name="bar2"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleY="0">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M50.88,44.12a3.12,3.12 0 0,1 6.25,0v19.75a3.12,3.12 0 0,1 -6.25,0z" />
            </group>
            <group
                android:name="bar3"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleY="0">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M58.88,49.12a2.62,2.62 0 0,1 5.25,0v9.75a2.62,2.62 0 0,1 -5.25,0z" />
            </group>
            <group
                android:name="bar4"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleY="0">
                <path
                    android:fillColor="#E6FFFFFF"
                    android:pathData="M65.62,52.88a2.12,2.12 0 0,1 4.25,0v2.25a2.12,2.12 0 0,1 -4.25,0z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="bubble">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.6" android:valueTo="1"
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.6" android:valueTo="1"
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bar0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="390"
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="250"
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="180"
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="320"
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="bar4">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="460"
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>

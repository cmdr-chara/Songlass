<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch splash (Android 12+ splash screen API): the icon's disc swells in with a slight
  overshoot, then the note rises into it. The disc spans the 160 dp circle the system shows.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="disc"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <path android:pathData="M54,18a36,36 0 1,1 0,72a36,36 0 1,1 0,-72z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="18" android:startY="18"
                            android:endX="90" android:endY="90"
                            android:startColor="#FFA58CFF"
                            android:endColor="#FF4B2FD0" />
                    </aapt:attr>
                </path>
                <path
                    android:fillColor="#33FFFFFF"
                    android:strokeColor="#99FFFFFF"
                    android:strokeWidth="1.2"
                    android:pathData="M54,35a19,19 0 1,1 0,38a19,19 0 1,1 0,-38z" />
                <path
                    android:strokeColor="#80FFFFFF"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:pathData="M41,47A14.5,14.5 0 0,1 57,39.8" />
            </group>
            <group
                android:name="note"
                android:pivotX="54"
                android:pivotY="54"
                android:translateX="-2.5"
                android:translateY="6">
                <path
                    android:name="note0"
                    android:fillAlpha="0"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M48.5,62.5a5,3.8 0 1,0 10,0a5,3.8 0 1,0 -10,0z" />
                <path
                    android:name="note1"
                    android:fillAlpha="0"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M56.7,43h2.3v19.5h-2.3z" />
                <path
                    android:name="note2"
                    android:fillAlpha="0"
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M59,43c0.4,3 1.9,4.5 4.2,6c2.6,1.9 3.4,4.5 2.3,7.5c-0.4,-3 -2.6,-4.9 -6.5,-5.6z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.6" android:valueTo="1"
                    android:duration="450"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.6" android:valueTo="1"
                    android:duration="450"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="note">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:valueFrom="6" android:valueTo="0"
                android:startOffset="220"
                android:duration="380"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
    <target android:name="note0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="220"
                android:duration="300" />
        </aapt:attr>
    </target>
    <target android:name="note1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="220"
                android:duration="300" />
        </aapt:attr>
    </target>
    <target android:name="note2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="220"
                android:duration="300" />
        </aapt:attr>
    </target>
</animated-vector>

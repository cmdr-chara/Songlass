<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the fade above the measured caption. The full text region needs a uniform
     backing, including the first line on bright covers and at larger font sizes.
     The 12 dp fade matches WidgetLayoutSizing.applyCompactLiquid's fadePadding. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:height="12dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#00000000" android:endColor="#99000000" />
        </shape>
    </item>
    <item android:top="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#99000000" />
        </shape>
    </item>
</layer-list>

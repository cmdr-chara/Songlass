<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash uses the app's own background so it hands over to the first screen seamlessly. -->
    <style name="Theme.Songlass" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">650</item>
    </style>
</resources>

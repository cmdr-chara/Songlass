<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".debug.NavigationLayerProbeActivity" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name=".debug.VisualAuditActivity" android:exported="true" android:permission="android.permission.DUMP" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <!-- Debug builds only: checks the media library like a car would. adb shell holds DUMP. -->
        <receiver
            android:name=".debug.BrowseProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.cmdrchara.songlass.debug.BROWSE_PROBE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".debug.ComposeTraceReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="dev.cmdrchara.songlass.debug.COMPOSE_TRACE" /></intent-filter>
        </receiver>
        <receiver android:name=".debug.FeatureProbeReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="dev.cmdrchara.songlass.debug.FEATURE_PROBE" /></intent-filter>
        </receiver>
        <receiver android:name=".debug.WelcomeReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="dev.cmdrchara.songlass.debug.WELCOME" /></intent-filter>
        </receiver>
        <receiver android:name=".debug.DefaultSoundProbeReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="dev.cmdrchara.songlass.debug.DEFAULT_SOUND_PROBE" /></intent-filter>
        </receiver>
    </application>
</manifest>

{
  "name": "songlass-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "lint": "eslint .",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "preview": "vite preview",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}

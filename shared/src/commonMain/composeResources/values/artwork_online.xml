    <string name="artwork_online_title">Online cover</string>
    <string name="artwork_online_privacy">Only the artist and album name are sent to the iTunes Search API. Files, folders, song titles and paths never leave the device.</string>
    <string name="artwork_online_provider">Provider: iTunes Search API</string>
    <string name="artwork_online_disabled">Online covers are off. Turn them on in Settings, Appearance, to search for a cover.</string>

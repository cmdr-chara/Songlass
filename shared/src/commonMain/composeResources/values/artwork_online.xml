    <!-- Settings -->
    <string name="settings_online_artwork">Online covers</string>
    <string name="settings_online_artwork_hint">Looks for an album cover using only the artist and album name. Nothing is downloaded until you choose a cover, and nothing is ever written into the music files.</string>
    <string name="settings_online_artwork_wifi">Download on Wi-Fi only</string>
    <string name="settings_online_artwork_wifi_hint">On mobile data the app waits instead of downloading. If the phone cannot report the connection, Wi-Fi only is assumed.</string>

